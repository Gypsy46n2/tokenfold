# TokenFold systemd user service.
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp tokenfold.service ~/.config/systemd/user/
#   edit WorkingDirectory + ExecStart paths below to where you unpacked TokenFold
#   systemctl --user daemon-reload
#   systemctl --user enable --now tokenfold
[Unit]
Description=TokenFold token-compression proxy
After=network.target

[Service]
Type=simple
# EDIT this path to your tokenfold/linux folder:
WorkingDirectory=%h/tokenfold/linux
ExecStart=%h/tokenfold/linux/.venv/bin/python -m tokenfold.cli serve --port 9339
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
